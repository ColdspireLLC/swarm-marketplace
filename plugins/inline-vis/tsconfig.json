{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024"],
    "types": [],
    "jsx": "react-jsx",
    "jsxImportSource": "swarm",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["swarm.d.ts", "**/*.ts", "**/*.tsx"]
}
