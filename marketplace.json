{
  "schemaVersion": 1,
  "name": "swarm",
  "displayName": "Swarm",
  "description": "Plugins reviewed by Coldspire.",
  "plugins": [
    {
      "id": "flux",
      "displayName": "Flux",
      "description": "Flux issues in Swarm, kept current by your threads.",
      "icon": "plugins/flux/icon.svg",
      "tags": [
        "issues",
        "tracker",
        "flux",
        "agents"
      ],
      "author": "Coldspire",
      "overview": "plugins/flux/PLUGIN_OVERVIEW.md",
      "source": {
        "git": {
          "url": "https://github.com/ColdspireLLC/swarm-marketplace.git",
          "subdir": "plugins/flux",
          "range": "^1.0.0",
          "tagPrefix": "flux/"
        }
      },
      "adds": [
        "App page",
        "Side panel",
        "Agent skill"
      ],
      "permissions": {
        "required": [
          "api:read",
          "storage",
          "network:*"
        ],
        "api": [
          "read"
        ],
        "storage": true,
        "network": [
          "*"
        ],
        "localNetwork": true,
        "threads": true,
        "mentions": true
      }
    },
    {
      "id": "coolify",
      "displayName": "Coolify",
      "description": "Your self-hosted Coolify in Swarm: deployments and their logs, rollbacks, env vars, and agents that deploy and fix failed builds.",
      "icon": "plugins/coolify/coolify.svg",
      "tags": [
        "deploy",
        "hosting",
        "coolify",
        "agents"
      ],
      "author": "Coldspire",
      "overview": "plugins/coolify/PLUGIN_OVERVIEW.md",
      "source": {
        "git": {
          "url": "https://github.com/ColdspireLLC/swarm-marketplace.git",
          "subdir": "plugins/coolify",
          "range": "^1.0.0",
          "tagPrefix": "coolify/"
        }
      },
      "adds": [
        "App page",
        "Settings page",
        "Composer status",
        "Agent skill",
        "Agent instructions",
        "MCP server for agents"
      ],
      "permissions": {
        "required": [
          "network:*"
        ],
        "network": [
          "*"
        ],
        "localNetwork": true,
        "http": true,
        "api": [
          "read",
          "agents"
        ]
      }
    },
    {
      "id": "test-machines",
      "displayName": "Test machines",
      "description": "Shared test machines and phones for your agents, one thread at a time on each screen: screenshots, elements, input, apps, files, recordings, with you first and sensitive apps off limits.",
      "icon": "plugins/test-machines/icon.svg",
      "tags": [
        "testing",
        "devices",
        "android",
        "ios",
        "agents"
      ],
      "author": "Coldspire",
      "overview": "plugins/test-machines/PLUGIN_OVERVIEW.md",
      "source": {
        "git": {
          "url": "https://github.com/ColdspireLLC/swarm-marketplace.git",
          "subdir": "plugins/test-machines",
          "range": "^1.0.0",
          "tagPrefix": "test-machines/"
        }
      },
      "adds": [
        "Side panel",
        "Settings page",
        "Agent tools",
        "Agent skill",
        "Agent instructions",
        "Command line"
      ],
      "permissions": {
        "api": [
          "read",
          "media"
        ],
        "process": [
          "bb",
          "ssh",
          "scp",
          "sh",
          "powershell",
          "adb",
          "aapt2",
          "curl",
          "osascript",
          "python3",
          "xcrun"
        ],
        "fs": [
          {
            "path": "~/.cache/test-machines"
          }
        ],
        "machines": true
      }
    }
  ]
}
